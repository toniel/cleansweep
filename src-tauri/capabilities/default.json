{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CleanSweep default capability — core commands only, filesystem access stays in Rust",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-reload"
  ]
}
